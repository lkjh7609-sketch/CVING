# ==========================================
# CVING 환경 변수 설정 템플릿 (.env.example)
# 앤트로픽(Anthropic) Gateway / Claude 설정
# ==========================================

# 1. 앤트로픽 Gateway API Key (필수 입력)
VITE_ANTHROPIC_API_KEY=your_anthropic_gateway_api_key_here

# 2. Gateway Base URL (기본값: https://api.anthropic.com/v1 또는 사용자 Gateway URL)
VITE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 3. 모델명 (Claude-sonnet-5)
VITE_ANTHROPIC_MODEL=Claude-sonnet-5

# 4. 제공자 (anthropic)
VITE_API_PROVIDER=anthropic
